{
  "id": "company.device-example",
  "name": "设备查询插件模板",
  "version": "1.0.0",
  "apiVersion": 2,
  "entry": "index.cjs",
  "description": "主动发送查询并等待响应标记的最小模板。",
  "configSchema": {
    "type": "object",
    "properties": {
      "command": {
        "type": "string",
        "title": "查询命令",
        "default": "AT+VERSION?\\r\\n",
        "minLength": 1
      },
      "expected": {
        "type": "string",
        "title": "响应标记",
        "default": "OK",
        "minLength": 1
      },
      "timeoutMs": {
        "type": "integer",
        "title": "超时（毫秒）",
        "default": 3000,
        "minimum": 100,
        "maximum": 30000
      }
    },
    "required": [
      "command",
      "expected",
      "timeoutMs"
    ],
    "additionalProperties": false
  },
  "actions": [
    {
      "id": "query",
      "label": "查询设备"
    }
  ],
  "autoRespond": false,
  "capabilities": [
    "stream.read",
    "stream.write"
  ],
  "transports": [
    "serial"
  ]
}
