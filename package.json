{
  "name": "dev-kit",
  "version": "0.3.0",
  "description": "嵌入式开发套件 —— 面向嵌入式软件开发的集成工具箱",
  "main": "./out/main/index.js",
  "author": "devkit",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "node tests/term-test.js && node tests/termflow-test.js && node tests/vtguard-test.js && node tests/logtext-test.js && node tests/diff-test.js && node tests/logic-test.js && node tests/mobamacro-test.js && node tests/quickcmd-test.js && node tests/net-test.js && node tests/tftp-test.js && node tests/ymodem-test.js && node tests/zmodem-test.js && node tests/bridge-test.js && node tests/theme-test.js && node tests/local-terminal-test.js && node tests/terminal-test.js && node tests/terminal-services-test.js && node tests/plugin-rx-redactor-test.js && node tests/plugin-retention-test.js && node tests/plugin-sdk-v2-test.js && node tests/workbench-review-test.js && node tests/picker-title-test.js && node tests/plugin-backend-test.js && node tests/plugin-ui-test.js && node tests/serial-plugins-test.js && node tests/branding-test.js && node tests/plugin-auth-branding-test.js && node --test tests/packaged-branding-test.cjs && node tests/app-updates-test.js",
    "test:pty-smoke": "electron scripts/pty-smoke.cjs",
    "test:extensions-smoke": "node scripts/extensions-workbench-smoke.cjs",
    "test:debug-unlock-smoke": "node scripts/debug-unlock-smoke.cjs",
    "dist": "npm run build && electron-builder --win",
    "dist:dir": "npm run build && electron-builder --dir",
    "dist:zip": "npm run build && electron-builder --win zip --x64",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "plugin:pack": "node scripts/package-device-plugin.cjs",
    "test:plugins-smoke": "node scripts/plugins-smoke.cjs",
    "icons:generate": "node scripts/generate-brand-icons.cjs",
    "icons:check": "node scripts/generate-brand-icons.cjs --check",
    "test:updates-smoke": "node scripts/app-updates-smoke.cjs",
    "test:branding-smoke": "node scripts/branding-smoke.cjs"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "diff": "^9.0.0",
    "element-plus": "^2.14.5",
    "iconv-lite": "^0.7.3",
    "node-pty": "^1.1.0",
    "pinia": "^4.0.3",
    "serialport": "^13.0.0",
    "ssh2": "^1.17.0",
    "zmodem.js": "^0.1.10"
  },
  "optionalDependencies": {
    "koffi": "^3.2.0",
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "^22.0.0",
    "@types/ssh2": "^1.15.6",
    "@vitejs/plugin-vue": "^6.0.8",
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "resedit": "1.7.2",
    "typescript": "^5.9.0",
    "unzipper": "0.12.5",
    "vite": "^7.0.0",
    "vue": "^3.5.42",
    "vue-tsc": "^3.3.11"
  },
  "build": {
    "appId": "com.embedded.devkit",
    "productName": "DevKit",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**",
      "resources/branding/app-256.png",
      "resources/branding/devkit.ico"
    ],
    "npmRebuild": false,
    "afterPack": "./scripts/package-updater.cjs",
    "asarUnpack": [
      "**/*.node",
      "node_modules/koffi/**",
      "node_modules/@koromix/**",
      "node_modules/uiohook-napi/**",
      "node_modules/serialport/**",
      "node_modules/@serialport/**",
      "node_modules/node-pty/**"
    ],
    "win": {
      "artifactName": "DevKit-${version}-win-${arch}.${ext}",
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/branding/devkit.ico"
    },
    "portable": {
      "artifactName": "DevKit-${version}-portable.exe"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "artifactName": "DevKit-${version}-mac-${arch}.${ext}",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "resources/branding/app-1024.png"
    },
    "linux": {
      "category": "Development",
      "artifactName": "DevKit-${version}-linux-${arch}.${ext}",
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "icon": "resources/branding/app-512.png"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smallfishworld/DevKit.git"
  },
  "homepage": "https://github.com/smallfishworld/DevKit",
  "bugs": {
    "url": "https://github.com/smallfishworld/DevKit/issues"
  }
}
